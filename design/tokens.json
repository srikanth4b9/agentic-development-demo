{
  "$description": "Support Desk DS tokens. Source of truth for src/styles/tokens.css and the 'Support Desk DS' variable collection in Figma. Figma name = CSS var without leading dashes, '-' group separator replaced by '/'.",
  "color": {
    "color/bg": { "$type": "color", "$value": "#f4f6fb", "css": "--color-bg" },
    "color/surface": { "$type": "color", "$value": "#ffffff", "css": "--color-surface" },
    "color/surface-muted": {
      "$type": "color",
      "$value": "#eef1f6",
      "css": "--color-surface-muted"
    },
    "color/border": { "$type": "color", "$value": "#dbe2ee", "css": "--color-border" },
    "color/border-strong": {
      "$type": "color",
      "$value": "#b8c3d6",
      "css": "--color-border-strong"
    },
    "color/text": { "$type": "color", "$value": "#1b2540", "css": "--color-text" },
    "color/text-muted": { "$type": "color", "$value": "#5b6785", "css": "--color-text-muted" },
    "color/primary": { "$type": "color", "$value": "#3355d6", "css": "--color-primary" },
    "color/primary-hover": {
      "$type": "color",
      "$value": "#2744b8",
      "css": "--color-primary-hover"
    },
    "color/primary-contrast": {
      "$type": "color",
      "$value": "#ffffff",
      "css": "--color-primary-contrast"
    },
    "color/focus-ring": { "$type": "color", "$value": "#6b8cff", "css": "--color-focus-ring" },
    "tone/neutral-bg": { "$type": "color", "$value": "#eef1f6", "css": "--tone-neutral-bg" },
    "tone/neutral-fg": { "$type": "color", "$value": "#3a4560", "css": "--tone-neutral-fg" },
    "tone/info-bg": { "$type": "color", "$value": "#e0ebff", "css": "--tone-info-bg" },
    "tone/info-fg": { "$type": "color", "$value": "#1f4fb3", "css": "--tone-info-fg" },
    "tone/warning-bg": { "$type": "color", "$value": "#fdf0c8", "css": "--tone-warning-bg" },
    "tone/warning-fg": { "$type": "color", "$value": "#7a5200", "css": "--tone-warning-fg" },
    "tone/accent-bg": { "$type": "color", "$value": "#e7e3fb", "css": "--tone-accent-bg" },
    "tone/accent-fg": { "$type": "color", "$value": "#4b3aa8", "css": "--tone-accent-fg" },
    "tone/success-bg": { "$type": "color", "$value": "#d9f3e6", "css": "--tone-success-bg" },
    "tone/success-fg": { "$type": "color", "$value": "#146c43", "css": "--tone-success-fg" },
    "tone/danger-bg": { "$type": "color", "$value": "#fde2e2", "css": "--tone-danger-bg" },
    "tone/danger-fg": { "$type": "color", "$value": "#a3242a", "css": "--tone-danger-fg" }
  },
  "space": {
    "space/1": { "$type": "dimension", "$value": 4, "css": "--space-1" },
    "space/2": { "$type": "dimension", "$value": 8, "css": "--space-2" },
    "space/3": { "$type": "dimension", "$value": 12, "css": "--space-3" },
    "space/4": { "$type": "dimension", "$value": 16, "css": "--space-4" },
    "space/5": { "$type": "dimension", "$value": 24, "css": "--space-5" },
    "space/6": { "$type": "dimension", "$value": 32, "css": "--space-6" },
    "space/7": { "$type": "dimension", "$value": 48, "css": "--space-7" }
  },
  "radius": {
    "radius/sm": { "$type": "dimension", "$value": 6, "css": "--radius-sm" },
    "radius/md": { "$type": "dimension", "$value": 10, "css": "--radius-md" },
    "radius/lg": { "$type": "dimension", "$value": 16, "css": "--radius-lg" },
    "radius/pill": { "$type": "dimension", "$value": 999, "css": "--radius-pill" }
  },
  "typography": {
    "Display/28 Bold": {
      "fontFamily": "Inter",
      "fontWeight": 700,
      "fontSize": 28,
      "lineHeight": 36,
      "css": "--font-size-xl"
    },
    "Heading/20 Bold": {
      "fontFamily": "Inter",
      "fontWeight": 700,
      "fontSize": 20,
      "lineHeight": 28,
      "css": "--font-size-lg"
    },
    "Title/16 Semibold": {
      "fontFamily": "Inter",
      "fontWeight": 600,
      "fontSize": 16,
      "lineHeight": 24,
      "css": "--font-size-md"
    },
    "Body/14 Regular": {
      "fontFamily": "Inter",
      "fontWeight": 400,
      "fontSize": 14,
      "lineHeight": 20,
      "css": "--font-size-sm"
    },
    "Label/14 Medium": {
      "fontFamily": "Inter",
      "fontWeight": 500,
      "fontSize": 14,
      "lineHeight": 20,
      "css": "--font-size-sm"
    },
    "Label/14 Semibold": {
      "fontFamily": "Inter",
      "fontWeight": 600,
      "fontSize": 14,
      "lineHeight": 20,
      "css": "--font-size-sm"
    },
    "Caption/12 Semibold": {
      "fontFamily": "Inter",
      "fontWeight": 600,
      "fontSize": 12,
      "lineHeight": 16,
      "css": "--font-size-xs"
    },
    "Caption/12 Regular": {
      "fontFamily": "Inter",
      "fontWeight": 400,
      "fontSize": 12,
      "lineHeight": 16,
      "css": "--font-size-xs"
    }
  }
}
